    <title>HP Colors Preset Builder V2</title>
    <meta
      name="description"
      content="Build HP Colors presets with the V2 in-game menu navigation."
    />
    <meta property="og:title" content="HP Colors Preset Builder V2" />
    <meta
      property="og:description"
      content="Build HP Colors presets with the V2 in-game menu navigation."
    />
    <link rel="icon" href="data:," />
