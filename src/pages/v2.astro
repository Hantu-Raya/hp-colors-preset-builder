---
import V2ImportConverter from '../components/V2ImportConverter.jsx';
import '../styles/v2.css';

const baseUrl = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Convert HP Colors presets to HPv2</title>
    <meta
      name="description"
      content="Convert legacy HP Colors preset imports and continue in the current HPv2 builder."
    />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content" class="v2-import-page">
      <V2ImportConverter baseUrl={baseUrl} client:load />
    </main>
  </body>
</html>
