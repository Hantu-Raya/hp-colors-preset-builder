---
import PresetBuilderV2Island from '../components/PresetBuilderV2Island.jsx';
import { getGitCommitInfo } from '../gitCommitInfo.js';
import '../styles/v2.css';

const gitCommitInfo = getGitCommitInfo();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HP Colors Preset Builder V2</title>
    <meta
      name="description"
      content="Build HP Colors presets with the V2 in-game menu navigation."
    />
    <meta property="og:title" content="HP Colors Preset Builder V2" />
    <meta
      property="og:description"
      content="Build HP Colors presets with the V2 in-game menu navigation."
    />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div
      id="kofi-leaderboard-embed"
      hidden
      data-leaderboard-id="X8X31HPU2G"
      data-leaderboard-name="Hanturaya's Leaderboard"
      data-leaderboard-theme="none"
    ></div>
    <script is:inline defer src="https://cdn.ko-fi.tools/v2/js/leaderboard.js" onerror="document.getElementById('kofi-leaderboard-embed')?.setAttribute('data-leaderboard-status', 'error')"></script>
    <main id="main-content" class="shell">
      <PresetBuilderV2Island gitCommitInfo={gitCommitInfo} client:load />
    </main>
  </body>
</html>
