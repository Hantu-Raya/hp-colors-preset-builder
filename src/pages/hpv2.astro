---
import PresetBuilderHPV2Island from '../components/PresetBuilderHPV2Island.jsx';
import { getGitCommitInfo } from '../gitCommitInfo.js';
import { loadSupporters } from '../supportersData.js';
import '../styles/hpv2.css';

const gitCommitInfo = getGitCommitInfo();
const supporters = await loadSupporters();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HP Colors Preset Builder HPv2</title>
    <meta
      name="description"
      content="Build HPv2 presets with the expanded preview and settings."
    />
    <meta property="og:title" content="HP Colors Preset Builder HPv2" />
    <meta
      property="og:description"
      content="Build HPv2 presets with the expanded preview and settings."
    />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content" class="shell">
      <PresetBuilderHPV2Island gitCommitInfo={gitCommitInfo} supporters={supporters} client:load />
    </main>
  </body>
</html>
